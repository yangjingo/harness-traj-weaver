#!/usr/bin/env bash
# === harness-traj-weaver — post-commit hook ===
# Writes a plan trigger after commit lands. The harness skill picks it up
# on next invocation to generate the next iteration plan.
#
# Install: cp hooks/post-commit .git/hooks/post-commit && chmod +x .git/hooks/post-commit

set -euo pipefail

SKIP=$(git config --get metaharness.skip 2>/dev/null || echo "false")
if [ "$SKIP" = "true" ]; then exit 0; fi

REPO_ROOT=$(git rev-parse --show-toplevel)
VERSION=$(grep -oP '## \[\K[0-9.]+(?=\])' "$REPO_ROOT/changelog.md" 2>/dev/null | head -1 || echo "0.1.0")
VERSION="v${VERSION:-0.1.0}"
COMMIT_HASH=$(git rev-parse --short HEAD)
OUTDIR="$REPO_ROOT/.metaharness/$VERSION/outputs"
INPUTDIR="$REPO_ROOT/.metaharness/$VERSION/inputs"
IN_CLAUDE="${CLAUDE_CODE_SESSION_ID:-}"
GOAL=$(git log -1 --pretty=%s)
CHANGED=$(git diff --cached --name-only 2>/dev/null)
CHANGED_COUNT=$(echo "$CHANGED" | wc -l)
TIMESTAMP=$(date -Iseconds)

mkdir -p "$OUTDIR" "$INPUTDIR"

# ── Archive session ──
if [ -n "$IN_CLAUDE" ]; then
    SESSION_FILE=$(ls "$HOME/.claude/projects"/*/"$IN_CLAUDE".jsonl 2>/dev/null | head -1)
    if [ -n "${SESSION_FILE:-}" ] && [ -f "$SESSION_FILE" ] && [ ! -f "$INPUTDIR/session-$IN_CLAUDE.jsonl" ]; then
        cp "$SESSION_FILE" "$INPUTDIR/session-$IN_CLAUDE.jsonl" 2>/dev/null || true
    fi
fi

# ── Write commit artifact ──
cat > "$OUTDIR/commit-$COMMIT_HASH.json" <<EOF
{
  "hash": "$COMMIT_HASH",
  "goal": "$GOAL",
  "changed_count": $CHANGED_COUNT,
  "changed_files": $(echo "$CHANGED" | python -c "import sys; print(json.dumps(sys.stdin.read().strip().split('\n')))" 2>/dev/null || echo "[]"),
  "timestamp": "$TIMESTAMP"
}
EOF

# ── Write plan trigger for next cycle ──
PLAN_TRIGGER="$REPO_ROOT/.metaharness/plan-trigger.json"
cat > "$PLAN_TRIGGER" <<EOF
{
  "from_version": "$VERSION",
  "last_commit": "$COMMIT_HASH",
  "last_goal": "$GOAL",
  "timestamp": "$TIMESTAMP",
  "action": "Run harness-traj-weaver plan to generate the next iteration proposal."
}
EOF

echo ""
echo "========================================"
echo "  harness-traj-weaver — $VERSION"
echo "========================================"
echo "  Commit:  $COMMIT_HASH — $GOAL"
echo "  Files:   $CHANGED_COUNT changed"
echo "  Archive: $OUTDIR/commit-$COMMIT_HASH.json"
echo ""
echo "  Plan trigger written → .metaharness/plan-trigger.json"
echo "  Next: harness-traj-weaver plan"
echo "========================================"
echo ""

exit 0
