#!/usr/bin/env bash
# === harness-traj-weaver — post-commit hook ===
# Terminal Q&A after commit lands. One question at a time, no browser required.
# Falls back to non-interactive mode inside Claude Code.
#
# Install: cp hooks/post-commit .git/hooks/post-commit && chmod +x .git/hooks/post-commit

set -euo pipefail

SKIP=$(git config --get metaharness.skip 2>/dev/null || echo "false")
if [ "$SKIP" = "true" ]; then exit 0; fi

REPO_ROOT=$(git rev-parse --show-toplevel)
VERSION=$(grep -oP '## \[\K[0-9.]+(?=\])' "$REPO_ROOT/changelog.md" 2>/dev/null | head -1 || echo "0.1.0")
VERSION="v${VERSION:-0.1.0}"
COMMIT_HASH=$(git rev-parse --short HEAD)
OUTDIR="$REPO_ROOT/.metaharness/$VERSION/outputs"
INPUTDIR="$REPO_ROOT/.metaharness/$VERSION/inputs"
ARCHIVE_SCRIPT="$REPO_ROOT/skills/survey/scripts/archive_feedback.py"
IN_CLAUDE="${CLAUDE_CODE_SESSION_ID:-}"
STAGED_STAT=$(git diff --cached --stat 2>/dev/null | tail -1)
GOAL=$(git log -1 --pretty=%s)

mkdir -p "$OUTDIR" "$INPUTDIR"

# ── Archive session ──
if [ -n "$IN_CLAUDE" ]; then
    SESSION_FILE=$(ls "$HOME/.claude/projects"/*/"$IN_CLAUDE".jsonl 2>/dev/null | head -1)
    if [ -n "${SESSION_FILE:-}" ] && [ -f "$SESSION_FILE" ] && [ ! -f "$INPUTDIR/session-$IN_CLAUDE.jsonl" ]; then
        cp "$SESSION_FILE" "$INPUTDIR/session-$IN_CLAUDE.jsonl" 2>/dev/null || true
    fi
fi

echo ""
echo "========================================"
echo "  harness-traj-weaver — Commit Review"
echo "========================================"
echo "  Version: $VERSION"
echo "  Commit:  $COMMIT_HASH — $GOAL"
echo "  Changes: ${STAGED_STAT:-unknown}"
echo ""

# ── Interactive mode (real terminal) ──
if [ -z "$IN_CLAUDE" ] && [ -t 0 ]; then

    echo "  Answer each question (1-5), then confirm GO/NO-GO."
    echo ""

    # Q1
    read -p "  Q1. 变更量是否合理? [5=非常精简 1=过度修改]: " Q1
    # Q2
    read -p "  Q2. 每个变更是否可追溯到 commit 目标? [5=全部 1=大量漂移]: " Q2
    # Q3
    read -p "  Q3. 文档/注释是否同步更新? [5=完整 1=未更新]: " Q3
    # Q4
    read -p "  Q4. 是否会破坏现有流水线/hook? [5=无影响 1=会破坏]: " Q4
    # Q5
    read -p "  Q5. trace 是否完整可回溯? [5=完整 1=无法回溯]: " Q5

    echo ""
    # Open human-loop for visual reference (optional)
    HUMAN_LOOP=$(ls -t "$OUTDIR"/human-loop-*.html 2>/dev/null | head -1)
    if [ -n "$HUMAN_LOOP" ]; then
        start "$HUMAN_LOOP" 2>/dev/null || open "$HUMAN_LOOP" 2>/dev/null || true
    fi

    # Final decision
    read -p "  Final decision — allow this commit? [g/n]: " DEC

    # Archive feedback
    FEEDBACK_FILE="$OUTDIR/meta-harness-feedback-$(date +%Y-%m-%dT%H-%M-%S).json"
    python -c "
import json
json.dump({
    'version': '$VERSION',
    'commit': '$COMMIT_HASH',
    'goal': '''$GOAL''',
    'qs': {'q1': '$Q1', 'q2': '$Q2', 'q3': '$Q3', 'q4': '$Q4', 'q5': '$Q5'},
    'decision': '$DEC',
    'timestamp': '$(date -Iseconds)'
}, open('$FEEDBACK_FILE', 'w'), indent=2, ensure_ascii=False)
" 2>/dev/null || true

    echo ""
    echo "========================================"
    if [ "$DEC" = "g" ]; then
        echo "  Decision: GO"
        echo "  Feedback archived → $FEEDBACK_FILE"
        echo ""
        echo "  Next: run the harness to start next iteration"
    else
        echo "  Decision: NO-GO"
        echo "  Feedback archived → $FEEDBACK_FILE"
        echo ""
        echo "  Next: review issues and re-commit"
    fi
    echo "========================================"
    echo ""

else
    # ── Non-interactive (Claude Code / CI) ──
    echo "  (non-interactive — human-loop available for manual review)"
    echo ""
fi

exit 0
