#!/usr/bin/env bash
# === harness-traj-weaver — pre-commit hook ===
# Generates review artifacts. Fast, always exits 0.
# Post-commit hook handles monitoring + human-in-the-loop.
#
# Install: cp hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

set -euo pipefail

SKIP=$(git config --get metaharness.skip 2>/dev/null || echo "false")
if [ "$SKIP" = "true" ]; then exit 0; fi
if git diff --cached --quiet; then exit 0; fi

REPO_ROOT=$(git rev-parse --show-toplevel)
COMMIT_MSG_FILE=$(git rev-parse --git-dir)/COMMIT_EDITMSG
GOAL=$(head -1 "$COMMIT_MSG_FILE" 2>/dev/null || echo "")
VERSION=$(grep -oP '## \[\K[0-9.]+(?=\])' "$REPO_ROOT/changelog.md" 2>/dev/null | head -1 || echo "0.1.0")
VERSION="v${VERSION:-0.1.0}"
SHORT_HASH=$(git diff --cached | sha256sum | cut -c1-8)
OUTDIR="$REPO_ROOT/.metaharness/$VERSION/outputs"
METRIC_SCRIPT="$REPO_ROOT/skills/metric/scripts/generate_dashboard.py"
SURVEY_SCRIPT="$REPO_ROOT/skills/survey/scripts/generate_survey.py"
SESSION_ID="${CLAUDE_CODE_SESSION_ID:-}"
INPUTDIR="$REPO_ROOT/.metaharness/$VERSION/inputs"
mkdir -p "$OUTDIR" "$INPUTDIR"

# ── Archive current session ──
if [ -n "$SESSION_ID" ]; then
    SESSION_FILE=$(ls "$HOME/.claude/projects"/*/"$SESSION_ID".jsonl 2>/dev/null | head -1)
    if [ -n "${SESSION_FILE:-}" ] && [ -f "$SESSION_FILE" ]; then
        cp "$SESSION_FILE" "$INPUTDIR/session-$SESSION_ID.jsonl" 2>/dev/null || true
        echo "  Session archived: session-$SESSION_ID.jsonl"
    fi
fi

echo ""
echo "=== harness-traj-weaver (pre-commit) ==="

# ── Metric review ──
if [ -f "$METRIC_SCRIPT" ]; then
    METRIC_OUT=$(python "$METRIC_SCRIPT" --diff HEAD --goal "$GOAL" --output /dev/null 2>&1 || true)
    SCORE=$(echo "$METRIC_OUT" | sed -n 's/.*Overall score:\s*\([0-9.]*\).*/\1/p' | head -1)
    echo "  Metric: ${SCORE:-?}/5"
fi

# ── Generate human-loop ──
HUMAN_LOOP="$OUTDIR/human-loop-$SHORT_HASH.html"
if [ -f "$SURVEY_SCRIPT" ]; then
    python "$SURVEY_SCRIPT" --type human-loop --version "$VERSION" --output "$HUMAN_LOOP" 2>/dev/null || true
    if [ -f "$HUMAN_LOOP" ]; then
        STAGED_DIFF=$(git diff --cached --stat 2>/dev/null | head -30)
        # Inject staged diff + decision form
        python -c "
html = open('$HUMAN_LOOP','r',encoding='utf-8').read()
diff_block = '<div class=\"question ctx-block\"><h3>Staged Changes</h3><pre style=\"font-family:JetBrains Mono,monospace;font-size:13px;white-space:pre-wrap;max-height:240px;overflow-y:auto;\">' + '''$STAGED_DIFF''' + '</pre></div>'
html = html.replace('<div class=\"question\">', diff_block + '<div class=\"question\">', 1)
decision = '''
<div class=\"question\" style=\"margin-top:32px;border:2px solid var(--primary);\">
  <h3>Final Decision</h3>
  <p style=\"color:var(--muted);margin-bottom:12px;\">Complete the survey above, then choose:</p>
  <button onclick=\"submit(\\'go\\')\" style=\"padding:12px 28px;font-size:15px;font-weight:500;border-radius:8px;border:none;cursor:pointer;background:#5db872;color:#fff;margin-right:12px;\">GO — Allow</button>
  <button onclick=\"submit(\\'nogo\\')\" style=\"padding:12px 28px;font-size:15px;font-weight:500;border-radius:8px;border:none;cursor:pointer;background:#c64545;color:#fff;\">NO-GO — Block</button>
  <div id=\"status\" style=\"margin-top:12px;font-size:14px;color:var(--muted);\"></div>
</div>
<script>
async function submit(d){document.getElementById(\"status\").textContent=\"Submitting...\";try{var data={decision:d,short_hash:\"$SHORT_HASH\",timestamp:new Date().toISOString()};document.querySelectorAll(\"input[type=radio]:checked\").forEach(function(e){data[e.name]=e.value});document.querySelectorAll(\"textarea\").forEach(function(e,i){if(e.value)data[\"text\"+i]=e.value});await fetch(\"http://127.0.0.1:8767/submit-feedback\",{method:\"POST\",headers:{\"Content-Type\":\"application/json\"},body:JSON.stringify(data)});document.getElementById(\"status\").textContent=d===\"go\"?\"GO — you may close this tab.\":\"NO-GO — noted.\";document.querySelectorAll(\"button\").forEach(function(b){b.disabled=true})}catch(e){document.getElementById(\"status\").textContent=\"Start server: python skills/survey/scripts/archive_feedback.py 8767\"}}
</script>
'''
html = html.replace('</body>', decision + '</body>')
open('$HUMAN_LOOP','w',encoding='utf-8').write(html)
" 2>/dev/null || true
        echo "  Human-loop: $HUMAN_LOOP"
    fi
fi

echo ""
exit 0
