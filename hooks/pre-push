#!/usr/bin/env bash
# === harness-traj-weaver — pre-push hook ===
# Generates push review artifacts. Fast, always exits 0.
# Install: cp hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
#
# Config:
#   git config metaharness.skip true     # skip hook entirely

set -euo pipefail

SKIP=$(git config --get metaharness.skip 2>/dev/null || echo "false")
if [ "$SKIP" = "true" ]; then exit 0; fi

REPO_ROOT=$(git rev-parse --show-toplevel)
VERSION=$(grep -oP '## \[\K[0-9.]+(?=\])' "$REPO_ROOT/changelog.md" 2>/dev/null | head -1 || echo "0.1.0")
VERSION="v${VERSION:-0.1.0}"
IN_CLAUDE="${CLAUDE_CODE_SESSION_ID:-}"
METRIC_SCRIPT="$REPO_ROOT/skills/metric/scripts/generate_dashboard.py"
SURVEY_SCRIPT="$REPO_ROOT/skills/survey/scripts/generate_survey.py"
OUTDIR="$REPO_ROOT/.metaharness/$VERSION/outputs"
mkdir -p "$OUTDIR"

while read -r local_ref local_sha remote_ref remote_sha; do
    if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then continue; fi

    RANGE="${remote_sha}..${local_sha}"
    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        RANGE="$local_sha"
    fi

    echo ""
    echo "=== harness-traj-weaver (push) ==="
    echo "  Range: $RANGE"
    echo ""

    if [ -n "$IN_CLAUDE" ]; then
        # Claude Code: local scripts only
        if [ -f "$METRIC_SCRIPT" ]; then
            python "$METRIC_SCRIPT" --diff "$RANGE" --output /dev/null 2>&1 || true
        fi
        if [ -f "$SURVEY_SCRIPT" ]; then
            python "$SURVEY_SCRIPT" --type human-loop --version "$VERSION" --output "$OUTDIR/human-loop-push-$(date +%Y%m%d-%H%M%S).html" 2>/dev/null || true
        fi
        echo "  (Claude Code — review artifacts generated)"
    else
        # Terminal: trigger full skill review
        PROMPT="harness-traj-weaver push review. Commits: $RANGE. Generate human-loop + traj → .metaharness/$VERSION/outputs/. Return verdict JSON."
        claude -p "$PROMPT" 2>/dev/null || echo '{"verdict":"skill-unavailable"}'
    fi

    echo ""
done

exit 0
